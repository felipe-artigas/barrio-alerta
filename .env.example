# Copiá este archivo como .env (desarrollo). NUNCA subas el .env real a Git.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Ruta del archivo SQLite. En producción: /var/lib/barrio-alerta/barrio-alerta.sqlite
DB_PATH=./data/barrio-alerta.sqlite

# Token para el "modo operador" (cambiar estados). En producción, mínimo 16 caracteres.
# Generar uno: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# 1 cuando la app corre detrás de Nginx (para conocer la IP real del visitante).
TRUST_PROXY=0

# IA (opcional). Sin key, la app funciona igual pero sin análisis automático.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=20000
# Máximo de análisis por día (protege la key compartida del consumo excesivo).
AI_DAILY_LIMIT=200

# Cargar reclamos de demostración si la base está vacía.
SEED_DEMO=true
